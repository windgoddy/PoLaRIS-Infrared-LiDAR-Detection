instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# macOS system files
.DS_Store
**/.DS_Store

# Ignore dataset files (images/masks/depth maps/LiDAR point clouds)
# PNG images (RGB/IR/masks)
dataset/**/*.png
dataset/**/*.PNG

# NumPy arrays (depth maps, preprocessed data)
dataset/**/*.npy

# LiDAR point clouds (binary format)
dataset/**/*.bin

# Keep only text files (train.txt, test.txt) and JSON files (calibration)
!dataset/**/*.txt
!dataset/**/*.json

# Visualization results (Phase 3 output)
vis_phase3_results/
vis_phase3_results/**/*

# Temporary data processing folders
dataset/**/json_prep/
dataset/**/json_prep/**/*

# Training results and model weights
result/
result/**/*
result_good/
result_good/**/*

# Additional file types to ignore
*.txt
*.tar
*.json
*.csv
*.png
*.backup

# Specific directories and files
dataset/009043/
dataset/009043/**/*
model_Mamba/dataset/smart_mask_utils.py


